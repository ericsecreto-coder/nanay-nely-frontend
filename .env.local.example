# Copy to .env.local — values from Supabase Dashboard > Project Settings > API
# NEVER add SUPABASE_SERVICE_ROLE_KEY here (server-only secret, not for frontend).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used for auth redirects and PWA manifest
NEXT_PUBLIC_SITE_URL=http://localhost:3000
